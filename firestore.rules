rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); } // Relaxed verified check for preview environment
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && request.auth.token != null && request.auth.token.email != null && (request.auth.token.email == "jkninja238@gmail.com" || request.auth.token.email == "admin@kuradex.com"); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Entities ---

    // Users
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && userId == request.auth.uid;
      allow update: if isSignedIn() && userId == request.auth.uid;

      match /likes/{likerId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && likerId == request.auth.uid;
      }
    }

    // Makers
    match /makers/{makerId} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    // Anime
    match /anime/{animeId} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    // Shops
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    // Action Figures
    match /actionFigures/{figureId} {
      function isValidFigure(data) {
        return isValidId(data.get('userId', ''))
          && (data.get('characterName', '') is string && data.get('characterName', '').size() <= 200)
          && (data.get('maker', '') is string && data.get('maker', '').size() <= 200)
          && (data.get('totalPrice', 0) is number && data.get('totalPrice', 0) >= 0)
          && (data.get('sourceAnime', '') is string && data.get('sourceAnime', '').size() <= 200)
          && (data.get('condition', '') is string && data.get('condition', '').size() <= 50);
      }

      allow read: if true;
      allow create: if isSignedIn() 
        && isValidId(figureId)
        && incoming().get('userId', '') == request.auth.uid 
        && isValidFigure(incoming());
      allow update: if isSignedIn() 
        && isValidId(figureId)
        && existing().get('userId', '') == request.auth.uid 
        && incoming().get('userId', '') == request.auth.uid 
        && isValidFigure(incoming())
        && (incoming().diff(existing()).affectedKeys().hasOnly(['characterName', 'maker', 'totalPrice', 'sourceAnime', 'condition', 'figureLine', 'imageUrls', 'isGifted', 'isSold', 'isLost', 'description', 'updatedAt', 'seasonArc', 'userId', 'createdAt']));
      allow delete: if isSignedIn() && isValidId(figureId) && existing().get('userId', '') == request.auth.uid;
    }

    // Preorders
    match /preorders/{preorderId} {
      function isValidPreorder(data) {
        return isValidId(data.get('userId', ''))
          && (data.get('characterName', '') is string && data.get('characterName', '').size() <= 200)
          && (data.get('sourceAnime', '') is string && data.get('sourceAnime', '').size() <= 200)
          && (data.get('maker', '') is string && data.get('maker', '').size() <= 200)
          && (data.get('seller', '') is string && data.get('seller', '').size() <= 200)
          && (data.get('preorderPrice', 0) is number && data.get('preorderPrice', 0) >= 0)
          && (data.get('downpayment', 0) is number && data.get('downpayment', 0) >= 0);
      }
      allow read: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow create: if isSignedIn() 
        && isValidId(preorderId)
        && incoming().get('userId', '') == request.auth.uid 
        && isValidPreorder(incoming());
      allow update: if isSignedIn() 
        && isValidId(preorderId)
        && existing().get('userId', '') == request.auth.uid 
        && incoming().get('userId', '') == request.auth.uid 
        && isValidPreorder(incoming())
        && (incoming().diff(existing()).affectedKeys().hasOnly(['characterName', 'sourceAnime', 'maker', 'figureLine', 'seller', 'preorderPrice', 'downpayment', 'datePreordered', 'estimatedArrivalFrom', 'estimatedArrivalTo', 'estimatedArrival', 'imageUrls', 'receivedAt', 'updatedAt', 'userId', 'createdAt']));
      allow delete: if isSignedIn() && isValidId(preorderId) && existing().get('userId', '') == request.auth.uid;
    }

    // Equipments
    match /equipments/{equipmentId} {
      function isValidEquipment(data) {
        return (data.get('userId', '') is string && data.get('userId', '').size() <= 128)
          && (data.get('description', '') is string && data.get('description', '').size() <= 1000)
          && (data.get('totalPrice', 0) is number && data.get('totalPrice', 0) >= 0);
      }
      allow read: if true;
      allow create: if isSignedIn() && incoming().get('userId', '') == request.auth.uid && isValidEquipment(incoming());
      allow update: if isSignedIn() && existing().get('userId', '') == request.auth.uid && incoming().get('userId', '') == request.auth.uid && isValidEquipment(incoming());
      allow delete: if isSignedIn() && existing().get('userId', '') == request.auth.uid;
    }

    // Showcases
    match /showcases/{showcaseId} {
      function isValidShowcase(data) {
        return (data.get('userId', '') is string && data.get('userId', '').size() <= 128)
          && (data.get('name', '') is string && data.get('name', '').size() <= 100)
          && (data.get('description', '') is string && data.get('description', '').size() <= 1000);
      }
      allow read: if true; // Publicly viewable
      allow create: if isSignedIn() && incoming().get('userId', '') == request.auth.uid && isValidShowcase(incoming());
      allow update: if isSignedIn() && existing().get('userId', '') == request.auth.uid && incoming().get('userId', '') == request.auth.uid && isValidShowcase(incoming());
      allow delete: if isSignedIn() && existing().get('userId', '') == request.auth.uid;
    }
  }
}
