rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { 
      return (isSignedIn() && request.auth.token != null && request.auth.token.email != null && (request.auth.token.email == "jkninja238@gmail.com" || request.auth.token.email == "admin@kuradex.com"));
    }

    // --- Entities ---

    // Accounts (custom username/password auth credentials)
    match /accounts/{username} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    // Users
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;

      match /likes/{likerId} {
        allow read: if true;
        allow create, update, delete: if true;
      }
    }

    // Makers
    match /makers/{makerId} {
      allow read: if true;
      allow create: if true;
    }

    // Anime
    match /anime/{animeId} {
      allow read: if true;
      allow create: if true;
    }

    // Shops
    match /shops/{shopId} {
      allow read: if true;
      allow create: if true;
    }

    // Action Figures
    match /actionFigures/{figureId} {
      function isValidFigure(data) {
        return isValidId(data.get('userId', ''))
          && (data.get('characterName', '') is string && data.get('characterName', '').size() <= 200)
          && (data.get('maker', '') is string && data.get('maker', '').size() <= 200)
          && (data.get('totalPrice', 0) is number && data.get('totalPrice', 0) >= 0)
          && (data.get('sourceAnime', '') is string && data.get('sourceAnime', '').size() <= 200)
          && (data.get('condition', '') is string && data.get('condition', '').size() <= 50);
      }

      allow read: if true;
      allow create: if isValidId(figureId) 
        && isValidFigure(incoming())
        && (isSignedIn() ? incoming().get('userId', '') == request.auth.uid : true);
      allow update: if isValidId(figureId) 
        && isValidFigure(incoming())
        && (isSignedIn() ? (existing().get('userId', '') == request.auth.uid && incoming().get('userId', '') == request.auth.uid) : true)
        && (incoming().diff(existing()).affectedKeys().hasOnly(['characterName', 'maker', 'totalPrice', 'sourceAnime', 'condition', 'figureLine', 'imageUrls', 'isGifted', 'isSold', 'isLost', 'description', 'updatedAt', 'seasonArc', 'userId', 'createdAt']));
      allow delete: if isValidId(figureId) && (isSignedIn() ? existing().get('userId', '') == request.auth.uid : true);
    }

    // Preorders
    match /preorders/{preorderId} {
      function isValidPreorder(data) {
        return isValidId(data.get('userId', ''))
          && (data.get('characterName', '') is string && data.get('characterName', '').size() <= 200)
          && (data.get('sourceAnime', '') is string && data.get('sourceAnime', '').size() <= 200)
          && (data.get('maker', '') is string && data.get('maker', '').size() <= 200)
          && (data.get('seller', '') is string && data.get('seller', '').size() <= 200)
          && (data.get('preorderPrice', 0) is number && data.get('preorderPrice', 0) >= 0)
          && (data.get('downpayment', 0) is number && data.get('downpayment', 0) >= 0);
      }
      allow read: if true;
      allow create: if isValidId(preorderId) 
        && isValidPreorder(incoming())
        && (isSignedIn() ? incoming().get('userId', '') == request.auth.uid : true);
      allow update: if isValidId(preorderId) 
        && isValidPreorder(incoming())
        && (isSignedIn() ? (existing().get('userId', '') == request.auth.uid && incoming().get('userId', '') == request.auth.uid) : true)
        && (incoming().diff(existing()).affectedKeys().hasOnly(['characterName', 'sourceAnime', 'maker', 'figureLine', 'seller', 'preorderPrice', 'downpayment', 'datePreordered', 'estimatedArrivalFrom', 'estimatedArrivalTo', 'estimatedArrival', 'imageUrls', 'receivedAt', 'updatedAt', 'userId', 'createdAt']));
      allow delete: if isValidId(preorderId) && (isSignedIn() ? existing().get('userId', '') == request.auth.uid : true);
    }

    // Equipments
    match /equipments/{equipmentId} {
      function isValidEquipment(data) {
        return (data.get('userId', '') is string && data.get('userId', '').size() <= 128)
          && (data.get('description', '') is string && data.get('description', '').size() <= 1000)
          && (data.get('totalPrice', 0) is number && data.get('totalPrice', 0) >= 0);
      }
      allow read: if true;
      allow create: if isValidEquipment(incoming()) && (isSignedIn() ? incoming().get('userId', '') == request.auth.uid : true);
      allow update: if isValidEquipment(incoming()) && (isSignedIn() ? (existing().get('userId', '') == request.auth.uid && incoming().get('userId', '') == request.auth.uid) : true);
      allow delete: if (isSignedIn() ? existing().get('userId', '') == request.auth.uid : true);
    }

    // Showcases
    match /showcases/{showcaseId} {
      function isValidShowcase(data) {
        return (data.get('userId', '') is string && data.get('userId', '').size() <= 128)
          && (data.get('name', '') is string && data.get('name', '').size() <= 100)
          && (data.get('description', '') is string && data.get('description', '').size() <= 1000);
      }
      allow read: if true;
      allow create: if isValidShowcase(incoming()) && (isSignedIn() ? incoming().get('userId', '') == request.auth.uid : true);
      allow update: if isValidShowcase(incoming()) && (isSignedIn() ? (existing().get('userId', '') == request.auth.uid && incoming().get('userId', '') == request.auth.uid) : true);
      allow delete: if (isSignedIn() ? existing().get('userId', '') == request.auth.uid : true);
    }
  }
}
